#!/usr/bin/env python3
"""Serves the bundled offline copy on localhost and opens it in the default browser.

The server keeps running in the background so repeat launches are instant, and exits
by itself after 30 minutes with no requests.
"""
import os
import socket
import subprocess
import sys
import threading
import time
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

PORT = 47831
IDLE_SECONDS = 30 * 60
DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
WWW = os.path.join(DATA, "solar-system-explorer", "www")
URL = f"http://127.0.0.1:{PORT}/solar-system-explorer/"


def already_running() -> bool:
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", PORT)) == 0


def open_browser() -> None:
    subprocess.Popen(["xdg-open", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def serve() -> None:
    last_request = [time.monotonic()]

    class Handler(SimpleHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def handle_one_request(self):
            last_request[0] = time.monotonic()
            super().handle_one_request()

    server = ThreadingHTTPServer(("127.0.0.1", PORT), partial(Handler, directory=WWW))

    def watchdog():
        while time.monotonic() - last_request[0] < IDLE_SECONDS:
            time.sleep(30)
        server.shutdown()

    threading.Thread(target=watchdog, daemon=True).start()
    server.serve_forever()


def main() -> int:
    if not os.path.isfile(os.path.join(WWW, "solar-system-explorer", "index.html")):
        print(f"No offline copy found in {WWW}. Re-run install.sh --offline.", file=sys.stderr)
        return 1
    if already_running():
        open_browser()
        return 0
    if os.fork() == 0:  # child keeps serving after the launcher returns
        os.setsid()
        sys.stdin.close()
        serve()
        return 0
    for _ in range(50):
        if already_running():
            break
        time.sleep(0.1)
    open_browser()
    return 0


if __name__ == "__main__":
    sys.exit(main())
